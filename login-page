<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign in | KTM Quotation Studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--sw:max(100vw,177.68vh);--bg:url(data:image/jpeg;base64,);--or:#f9a02c;--f:"Inter","Segoe UI",system-ui,sans-serif}
*{box-sizing:border-box;margin:0}
html,body{height:100%;overflow:hidden;background:#0b0f18 var(--bg) center/cover no-repeat;font-family:var(--f);color:#fff}
body::before{content:"";position:fixed;inset:0;background:inherit;filter:blur(28px) brightness(.7);transform:scale(1.1)}
.stage{position:absolute;left:calc(50% - var(--sw)/2);top:calc(50% - var(--sw)*.2814);width:var(--sw);aspect-ratio:1672/941;container-type:inline-size;
  background:var(--bg) 0 0/100% 100% no-repeat}
@media(max-width:600px){.stage{width:300vw;left:-185.8vw;top:calc(50% - 84.4vw)}}
.ov{position:absolute;inset:0;pointer-events:none}
.ov[hidden]{display:none}
.ov>*{position:absolute;pointer-events:auto}
input,button,a{font-family:var(--f)}
.f{background:transparent;border:0;color:#fff;font-size:max(1.02cqw,16px);padding:0 1cqw 0 3.1cqw;border-radius:.84cqw;caret-color:#fff}
.f::placeholder{color:#a9afbc;opacity:1}
.f:focus{outline:0;box-shadow:0 0 0 .18cqw rgba(249,160,44,.75);background:rgba(255,255,255,.04)}
.f[aria-invalid=true]{box-shadow:0 0 0 .18cqw rgba(255,122,107,.85)}
.f.pw{padding-right:4.6cqw}
.hit{background:transparent;border:0;cursor:pointer;border-radius:.7cqw;display:block}
.hit:hover{background:rgba(255,255,255,.08)}
.hit:focus-visible,.link:focus-visible{outline:.15cqw solid var(--or);outline-offset:.1cqw}
.link{background:transparent;border:0;color:transparent;cursor:pointer;display:block;border-radius:.4cqw}
.link:hover{background:rgba(249,160,44,.12)}
.eye{display:grid;place-items:center;cursor:pointer;background:transparent;border:0;border-radius:.6cqw}
.eye svg{width:1.35cqw;height:1.35cqw;fill:#e9e9ee}
.eye:focus-visible{outline:.15cqw solid var(--or)}
.cta{border:0;border-radius:999px;cursor:pointer;background:transparent;color:#1b1206;font:700 1.12cqw var(--f);display:grid;place-items:center;transition:background .2s}
.cta:hover{background:rgba(255,255,255,.1)}
.cta.busy{background:linear-gradient(180deg,#fdc153,#fcae45);cursor:progress}
.cta span{opacity:0}.cta.busy span{opacity:1}
.logo{position:fixed;z-index:5;display:block;width:calc(var(--sw)*.0945);left:calc(50vw - var(--sw)/2 + var(--sw)*.0461);top:max(14px,calc(50vh - var(--sw)/3.5536 + var(--sw)*.0124))}
.logo img{width:100%;height:auto;display:block}
@media(max-width:600px){.logo{width:104px;left:16px;top:16px}}
/* sign-up panel */
.up{border-radius:1.9cqw;background:url(data:image/jpeg;base64,) 0 0/100% 100% no-repeat;overflow:hidden;padding:2.3cqw 2.9cqw;display:flex;flex-direction:column;gap:.75cqw;animation:in .35s ease both}
@keyframes in{from{opacity:0;transform:translateY(.8cqw)}}
.up h2{font-size:2.15cqw;font-weight:700}
.up .sub{color:#c3c8d4;font-size:1.05cqw;margin:-.4cqw 0 .2cqw}
.up label{font-size:.95cqw;font-weight:500;display:block;margin-bottom:.45cqw}
.up .f{width:100%;height:2.95cqw;padding-left:1.2cqw;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.07)}
.up .f:focus{border-color:var(--or)}
.up .pwrap{position:relative}.up .pwrap .eye{position:absolute;right:.4cqw;top:50%;transform:translateY(-50%);width:2.4cqw;height:2.4cqw}
.up .cta2{height:3.1cqw;border:0;border-radius:999px;cursor:pointer;background:linear-gradient(180deg,#fdc153,#fcae45);color:#1b1206;font:700 1.12cqw var(--f);margin-top:.5cqw;transition:filter .2s}
.up .cta2:hover{filter:brightness(1.06)}.up .cta2[disabled]{opacity:.75;cursor:progress}
.up .sw{text-align:center;font-size:1cqw;margin-top:.2cqw}
.up .sw a{color:var(--or);font-weight:600;margin-left:.4cqw;text-decoration:none;cursor:pointer}
.e{color:#ff8a7a;font-size:.85cqw;margin-top:.3cqw;min-height:0}
.toast{position:fixed;left:50%;top:22px;transform:translate(-50%,-20px);opacity:0;pointer-events:none;z-index:9;padding:12px 20px;border-radius:999px;
  background:rgba(24,24,32,.9);border:1px solid rgba(255,255,255,.2);font:500 14px var(--f);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);transition:.3s;max-width:90vw;text-align:center}
.toast.on{opacity:1;transform:translate(-50%,0)}.toast.bad{border-color:#ff8a7a;color:#ffb3a8}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
/* real text (crisp at any size) */
.hero{position:absolute;left:7.5%;top:35.6%;text-shadow:0 .1cqw .6cqw rgba(0,0,0,.35)}
.hero .eb{font-size:.86cqw;font-weight:400;letter-spacing:.2em;color:#f2ede6}
.hero h1{font-size:3.1cqw;line-height:1.14;font-weight:700;margin:.55cqw 0 .9cqw;letter-spacing:-.01em}
.hero h1 em{font-style:normal;color:#f9a02c}
.hero .tag{font-size:1.2cqw;color:#fff}
.up .fg{align-self:flex-end;background:transparent;border:0;color:var(--or);font:500 .95cqw var(--f);cursor:pointer;margin:-.2cqw 0 -.1cqw}
.up .or{display:flex;align-items:center;gap:1cqw;color:#c3c8d4;font-size:.9cqw}
.up .or:before,.up .or:after{content:"";flex:1;height:1px;background:rgba(255,255,255,.2)}
.up .soc{display:grid;grid-template-columns:repeat(3,1fr);gap:.9cqw}
.up .sb{height:3.2cqw;border-radius:.9cqw;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.06);cursor:pointer;display:grid;place-items:center}
.up .sb:hover{background:rgba(255,255,255,.12)}
.up .sb svg{width:1.5cqw;height:1.5cqw}
.up .sb:focus-visible,.up .fg:focus-visible,.up .sw a:focus-visible{outline:.15cqw solid var(--or)}
.up .e{margin-top:.2cqw}
#f-in .up{justify-content:center;gap:1.05cqw}
</style>
</head>
<body>
<div class="stage">
 <div class="hero"><p class="eb">BUILD A BRIGHTER TOMORROW</p><h1>Solar Solutions<br>for a <em>Cleaner World</em></h1><p class="tag">Design &nbsp;&bull;&nbsp; Engineer &nbsp;&bull;&nbsp; Quote &nbsp;&bull;&nbsp; Deliver</p></div>
 <form id="f-in" class="ov" data-mode="in" novalidate>
  <div class="up" style="left:63.457%;top:14.772%;width:30.263%;height:69.501%">
   <div><h2>Welcome Back</h2></div><p class="sub">Sign in to your account</p>
   <div><label for="i-e">Email</label><input class="f" id="i-e" name="email" type="email" autocomplete="email" placeholder="Enter your email"><div class="e"></div></div>
   <div><label for="i-p">Password</label><div class="pwrap"><input class="f" id="i-p" name="password" type="password" autocomplete="current-password" placeholder="Enter your password"><button class="eye" type="button" aria-label="Show password"><svg viewBox="0 0 24 24"><path d="M12 6.5c4.2 0 7.4 3 8.700 5.500-.5 1-1.300 2-2.200 2.800l1.400 1.400c1.400-1.300 2.500-2.900 3.100-4.200C21.800 8.800 17.600 4.500 12 4.500c-1.400 0-2.700.3-3.900.8l1.600 1.600c.7-.3 1.500-.4 2.300-.4zM2.100 3.500 3.500 2.100l18.400 18.400-1.400 1.400-3-3c-1.400.6-3 .9-5.500.9C6.400 19.800 2.200 15.200.9 12c.7-1.700 1.900-3.300 3.500-4.600zm5.200 5.200a5 5 0 0 0 6.900 6.900l-1.500-1.500a3 3 0 0 1-3.900-3.900z"/></svg></button></div><div class="e"></div></div>
   <button class="fg" type="button" data-act="forgot">Forgot password?</button>
   <button class="cta2" type="submit">Sign In &rarr;</button>
   <div class="or"><span>or continue with</span></div>
   <div class="soc"><button class="sb" type="button" data-p="google" aria-label="Continue with Google"><svg viewBox="0 0 48 48"><path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.080 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.650-.389-3.917z"/><path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/><path fill="#4CAF50" d="M24 44c5.166 0 9.860-1.977 13.409-5.192l-6.190-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/><path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571l.003-.002 6.190 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.650-.389-3.917z"/></svg></button><button class="sb" type="button" data-p="microsoft" aria-label="Continue with Microsoft"><svg viewBox="0 0 24 24"><path fill="#F25022" d="M3 3h8.500v8.500H3z"/><path fill="#7FBA00" d="M12.500 3H21v8.500h-8.500z"/><path fill="#00A4EF" d="M3 12.500h8.500V21H3z"/><path fill="#FFB900" d="M12.500 12.500H21V21h-8.500z"/></svg></button><button class="sb" type="button" data-p="apple" aria-label="Continue with Apple"><svg viewBox="0 0 24 24"><path fill="#fff" d="M16.400 12.600c0-2.400 2-3.500 2.100-3.600-1.200-1.700-3-1.900-3.600-2-1.500-.2-3 .9-3.800.9s-2-.9-3.300-.9C6.100 7 4.500 8 3.700 9.500c-1.800 3.100-.5 7.700 1.300 10.200.8 1.200 1.800 2.600 3.100 2.500 1.300-.1 1.700-.8 3.200-.8s1.900.8 3.200.8c1.300 0 2.200-1.200 3-2.400.9-1.400 1.300-2.700 1.300-2.800 0 0-2.500-1-2.400-4.400zM14 5.200c.7-.8 1.100-1.900 1-3-1 0-2.100.7-2.800 1.500-.6.700-1.200 1.800-1 2.900 1.100.1 2.100-.6 2.800-1.400z"/></svg></button></div>
   <p class="sw">Don&rsquo;t have an account?<a data-go="up" tabindex="0" role="button">Create one</a></p>
  </div>
 </form>

 <form id="f-up" class="ov" data-mode="up" novalidate hidden>
  <div class="up" style="left:63.457%;top:14.772%;width:30.263%;height:69.501%">
   <div><h2>Create Account</h2></div><p class="sub">Set up access to your quotations</p>
   <div><label for="u-n">Full name</label><input class="f" id="u-n" name="name" autocomplete="name" placeholder="Enter your full name"><div class="e"></div></div>
   <div><label for="u-e">Work email</label><input class="f" id="u-e" name="email" type="email" autocomplete="email" placeholder="Enter your email"><div class="e"></div></div>
   <div><label for="u-r">Your Role</label><input class="f" id="u-r" name="role" autocomplete="organization-title" placeholder="Type your Role"><div class="e"></div></div>
   <div><label for="u-p">Password</label><div class="pwrap"><input class="f" id="u-p" name="password" type="password" autocomplete="new-password" placeholder="At least 8 characters"><button class="eye" type="button" aria-label="Show password"><svg viewBox="0 0 24 24"><path d="M12 6.5c4.2 0 7.4 3 8.700 5.500-.5 1-1.300 2-2.200 2.800l1.400 1.400c1.400-1.300 2.500-2.900 3.100-4.200C21.800 8.800 17.600 4.500 12 4.500c-1.400 0-2.700.3-3.900.8l1.600 1.600c.7-.3 1.500-.4 2.300-.4zM2.100 3.500 3.500 2.100l18.400 18.400-1.400 1.400-3-3c-1.400.6-3 .9-5.500.9C6.400 19.800 2.200 15.200.9 12c.7-1.700 1.900-3.300 3.500-4.600zm5.200 5.200a5 5 0 0 0 6.900 6.900l-1.500-1.500a3 3 0 0 1-3.900-3.900z"/></svg></button></div><div class="e"></div></div>
   <button class="cta2" type="submit">Create Account</button>
   <p class="sw">Already have an account?<a data-go="in" tabindex="0" role="button">Sign in</a></p>
  </div>
 </form>
</div>
<a class="logo" href="#" aria-label="KTM Energy Experts"><img src="data:image/png;base64," alt="KTM Energy Experts"></a>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
const EYE_OFF='<svg viewBox="0 0 24 24"><path d="M12 6.5c4.2 0 7.4 3 8.700 5.500-.5 1-1.300 2-2.200 2.800l1.400 1.400c1.400-1.300 2.500-2.900 3.100-4.200C21.800 8.800 17.600 4.500 12 4.500c-1.400 0-2.700.3-3.900.8l1.600 1.600c.7-.3 1.500-.4 2.300-.4zM2.100 3.500 3.500 2.100l18.400 18.400-1.400 1.400-3-3c-1.400.6-3 .9-5.500.9C6.400 19.800 2.200 15.200.9 12c.7-1.700 1.900-3.300 3.500-4.600zm5.200 5.200a5 5 0 0 0 6.900 6.900l-1.500-1.500a3 3 0 0 1-3.900-3.900z"/></svg>',EYE_ON='<svg viewBox="0 0 24 24"><path d="M12 5C6.500 5 2.700 9 1.500 12c1.200 3 5 7 10.500 7s9.300-4 10.500-7C21.300 9 17.500 5 12 5zm0 11.500a4.500 4.500 0 1 1 0-9 4.500 4.500 0 0 1 0 9zm0-7a2.500 2.500 0 1 0 0 5 2.500 2.500 0 0 0 0-5z"/></svg>';
const F={in:document.getElementById('f-in'),up:document.getElementById('f-up')},T=document.getElementById('toast');let tt;
function toast(m,bad){T.textContent=m;T.className='toast on'+(bad?' bad':'');clearTimeout(tt);tt=setTimeout(()=>T.className='toast',3600);}
document.querySelectorAll('[data-go]').forEach(a=>{const go=()=>{const m=a.dataset.go;F.in.hidden=m!=='in';F.up.hidden=m!=='up';F[m].querySelector('input').focus();};a.onclick=go;a.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go();}};});
document.querySelector('[data-act=forgot]').onclick=()=>toast('Password reset is not connected yet.');
document.querySelectorAll('.eye').forEach(b=>b.onclick=()=>{const i=b.parentElement.querySelector('input'),s=i.type==='password';i.type=s?'text':'password';b.innerHTML=s?EYE_ON:EYE_OFF;b.setAttribute('aria-label',(s?'Hide':'Show')+' password');});
const rx=/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
function check(f){let ok=true,first=null,msg='';f.querySelectorAll('input.f').forEach(i=>{let m='';const v=i.value.trim();
  if(i.name==='name'&&!v)m='Enter your full name.';
  if(i.name==='role'&&!v)m='Enter your role.';
  if(i.name==='email'&&!rx.test(v))m='Enter a valid email address.';
  if(i.name==='password'){if(!i.value)m='Enter your password.';else if(f.dataset.mode==='up'&&i.value.length<8)m='Use at least 8 characters.';}
  i.setAttribute('aria-invalid',!!m);const e=i.closest('div')?.querySelector('.e');if(e)e.textContent=m;
  if(m){ok=false;first=first||i;msg=msg||m;}});
  if(!ok){first.focus();if(f.dataset.mode==='in')toast(msg,true);}return ok;}
document.querySelectorAll('input.f').forEach(i=>i.addEventListener('input',()=>{i.setAttribute('aria-invalid','false');const e=i.closest('div')?.querySelector('.e');if(e)e.textContent='';}));

/* Connect your real auth here (Firebase / Supabase / your API). provider: 'password' | 'google' | 'microsoft' | 'apple' */
async function submitAuth(mode,data,provider='password'){await new Promise(r=>setTimeout(r,900));return{ok:true};}
async function run(f,provider,data){
  const btn=f.querySelector('.cta,.cta2');btn.disabled=true;btn.classList.add('busy');const t=btn.textContent;if(btn.classList.contains('cta2'))btn.textContent=f.dataset.mode==='in'?'Signing in…':'Creating account…';
  try{const r=await submitAuth(f.dataset.mode,data,provider);if(!r.ok)throw 0;toast(f.dataset.mode==='in'?'Signed in. Opening your workspace…':'Account created. Opening your workspace…');/* location.href='dashboard.html'; */}
  catch(_){toast('Something went wrong. Check your details and try again.',true);}
  btn.disabled=false;btn.classList.remove('busy');if(btn.classList.contains('cta2'))btn.textContent=t;}
Object.values(F).forEach(f=>{f.addEventListener('submit',e=>{e.preventDefault();if(check(f))run(f,'password',Object.fromEntries(new FormData(f)));});
  f.querySelectorAll('[data-p]').forEach(b=>b.onclick=()=>run(f,b.dataset.p,{}));});
</script>
</body>
</html>
